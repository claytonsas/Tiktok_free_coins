# Copiez ce fichier en .env (jamais commité). Nécessaire uniquement pour le mode réel.
# Créez une clé API avec le droit "trading spot" UNIQUEMENT : jamais le droit de retrait.
EXCHANGE_API_KEY=
EXCHANGE_API_SECRET=
# Seulement pour les exchanges qui en demandent un (OKX, KuCoin...)
EXCHANGE_API_PASSWORD=

# Notifications Telegram (optionnel) : créez un bot avec @BotFather
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
